# Local development needs no configuration: Vite proxies /eve to this target.
# Override it only when Eve listens somewhere other than its default address.
EVE_PROXY_TARGET="http://127.0.0.1:2000"

# Set this only when the built frontend and Eve are deployed on different
# origins. Use an HTTPS origin and do not append /eve/v1.
# VITE_EVE_URL="https://your-eve-deployment.example.com"

# Maps JavaScript API key used to render the interactive map on MapScreen.
# This key is sent to the browser, so create a SEPARATE key from
# GOOGLE_MAPS_API (backend/.env) and restrict it by HTTP referrer in Google
# Cloud Console to your dev/prod origins. Never reuse the backend's
# server-side key here.
VITE_GOOGLE_MAPS_API_KEY=

# Map ID required by AdvancedMarkerElement (MapScreen's pin markers). Create
# one in Google Cloud Console > Google Maps Platform > Map Management, and
# associate it with a Map style. Falls back to Google's shared "DEMO_MAP_ID"
# for local development if left unset — do not rely on DEMO_MAP_ID in
# production.
VITE_GOOGLE_MAPS_MAP_ID=
